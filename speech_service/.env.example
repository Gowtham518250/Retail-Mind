# Long random shared secret. Must match Retail Mind API configuration.
INDIC_SPEECH_SERVICE_API_KEY=replace-with-a-long-random-secret

# Optional after accepting model access terms on Hugging Face.
HF_TOKEN=

# Optional: cuda or cpu. Defaults to CUDA if a compatible runtime is available.
VOICE_MODEL_DEVICE=cuda

# Local English-only speech recognition quality/speed choice.
ENGLISH_WHISPER_SIZE=small

# Optional model overrides.
INDIC_ASR_MODEL=ai4bharat/indic-conformer-600m-multilingual
INDIC_TRANSLATION_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
