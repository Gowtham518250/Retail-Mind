# Shared long random secret; must match Retail Mind's INDIC_SPEECH_SERVICE_API_KEY
INDIC_SPEECH_SERVICE_API_KEY=replace-with-a-long-random-secret

# Optional. Needed if Hugging Face requires an accepted gated-model agreement.
HF_TOKEN=

# Use cuda on the GPU PC or cpu where no compatible CUDA runtime is installed.
VOICE_MODEL_DEVICE=cuda

# English-only speech recognition quality/speed.
ENGLISH_WHISPER_SIZE=small
