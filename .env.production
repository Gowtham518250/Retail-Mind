# 🔐 PRODUCTION ENVIRONMENT - USE ENV VARIABLES ONLY
# DO NOT COMMIT TO GIT - All values must be set as environment variables on deployment platform

# Database Configuration
# Example: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=${DATABASE_URL}

# Redis Configuration
REDIS_URL=${REDIS_URL}

# JWT & Security (Generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=${SECRET_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration
SENDER_EMAIL=${SENDER_EMAIL}
SENDER_PASSWORD=${SENDER_PASSWORD}
SMTP_SERVER=${SMTP_SERVER}
SMTP_PORT=587
SENDER_PASSWORD=${SENDER_PASSWORD}
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Server Port
PORT=10000

# Environment
DEBUG=False
ENVIRONMENT=production
LOG_LEVEL=INFO

# API Configuration
API_URL=http://localhost:8000
