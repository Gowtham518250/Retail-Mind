# Public website origin used for canonical URLs, Open Graph, robots.txt, and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://retail-mind-1.onrender.com
# Browser API and same-origin proxy backend
NEXT_PUBLIC_API_URL=https://retail-mind-hpx3.onrender.com
RETAIL_MIND_BACKEND_URL=
# Optional comma-separated shop IDs if build-time backend discovery is unavailable
NEXT_PUBLIC_KNOWN_SHOP_IDS=
# Optional real Google Search Console HTML-tag verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional GA4 web-stream ID, e.g. G-XXXXXXXXXX. Analytics stays off without consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional real support address; enables the contact form and contact metadata.
NEXT_PUBLIC_SUPPORT_EMAIL=