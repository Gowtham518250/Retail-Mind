+    <motion.g
+      style={BOX}
+      animate={reduce ? undefined : { y: [0, -dy, 0], rotate: [-2, 2, -2] }}
+      transition={{ duration: dur, delay, repeat: Infinity, ease: 'easeInOut' }}
+    >
+      {children}
+    </motion.g>
+  );
+}
+
+function Pop({ children, delay, reduce }: { children: React.ReactNode; delay: number; reduce: boolean }) {
+  return (
+    <motion.g
+      style={BOX}
